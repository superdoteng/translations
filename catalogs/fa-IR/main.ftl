settings-search-entry-keyboard-shortcuts-shortcuts-keyboard-shortcuts-description = جستجو، ضبط، ویرایش و بازنشانی میانبرهای کیبورد.
settings-search-entry-palette-sources-keyboard-shortcut-label = میانبر کیبورد
